{
  "name": "xkautotester-electron",
  "version": "0.1.2-dev.5",
  "description": "XKAutoTester - 基于Electron+Python的自动化测试平台",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "automation",
    "testing",
    "material-design"
  ],
  "author": "RiNG",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.6.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0"
  },
  "build": {
    "appId": "com.ring.xkautotester",
    "productName": "XKAutoTester",
    "artifactName": "${productName} Setup v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "splash.html",
      "renderer/**/*",
      "assets/**/*",
      "locales/**/*",
      "node_modules/**/*"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../config",
        "to": "config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../.venv",
        "to": ".venv",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../env",
        "to": "env",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "../uv.lock",
        "to": "uv.lock"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
