{
  "name": "xkautotester-electron",
  "version": "0.1.3-dev.3",
  "description": "XKAutoTester - 基于Electron+Python的自动化测试平台",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "version:bump": "python ../scripts/sync_version.py",
    "version:verify": "python ../scripts/sync_version.py --verify",
    "version:sync": "python ../scripts/sync_version.py --sync",
    "postinstall": "node patch-nsis.js",
    "prebuild": "node patch-nsis.js",
    "prebuild-win": "node patch-nsis.js"
  },
  "keywords": [
    "electron",
    "automation",
    "testing",
    "material-design"
  ],
  "author": "RiNG",
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.6.0",
    "i18next": "^25.8.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide": "^1.8.0"
  },
  "build": {
    "appId": "com.ring.xkautotester",
    "productName": "XKAutoTester",
    "artifactName": "${productName} Setup v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "splash.html",
      "renderer/**/*",
      "assets/**/*",
      "locales/**/*",
      "templates/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "src/preload/**/*"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src",
        "filter": [
          "**/*.py",
          "**/*.json"
        ]
      },
      {
        "from": "../config/pytest.ini",
        "to": "config/pytest.ini"
      },
      {
        "from": "../.venv",
        "to": ".venv",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../env",
        "to": "env",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "pyproject.toml"
      },
      {
        "from": "../uv.lock",
        "to": "uv.lock"
      },
      {
        "from": "../version.json",
        "to": "version.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp"
    }
  }
}