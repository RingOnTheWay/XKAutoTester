# ================================
# XKAutoTester .gitignore
# ================================

# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python

# Python 工具缓存
.ruff_cache/
.pytest_cache/

# uv
.uv-cache/

# --- Node.js / Electron ---
node_modules/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite / electron-vite
.vite/
dist-electron/

# Electron-builder
/electron/dist/
/electron/build/
/electron/out/

# --- Environments ---
.venv/
.env
.env.local
.env.*.local

# 内置工具环境（Python/Android SDK/scrcpy/驱动）
/env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.trae/
.qoder/

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Logs ---
/logs/
*.log

# --- Allure ---
allure-results/
allure-report/

# --- Playwright ---
playwright-report/
test-results/
blob-report/

# --- 临时文件 ---
*.tmp
*.temp

# --- 大体积二进制文件 ---
*.apk
*.aab

# --- 密钥和证书 ---
*.keystore
*.jks
*.p12
*.pem
*.key

# --- 用户数据（运行时生成，安装更新时必须保留） ---
/config/config.json
/config/ble_device.json
/config/page_package.json
/config/test_plans.json
/config/scheduled_plans.json
/config/test_cases/

# --- AI Agent 上下文 ---
/trae-backup
refactor-rfcs
/dev-records
.workbuddy/

# --- 发布脚本运行时产物 ---
/scripts/xkat-*.json
/scripts/xkat-*.txt

# --- npm 本地缓存 (CI/构建临时) ---
.npm-cache/
